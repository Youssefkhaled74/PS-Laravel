{
  "info": {
    "name": "PS Vendor Password Reset",
    "_postman_id": "ps-vendor-password-reset-collection",
    "description": "Vendor password reset flow: forgot -> verify-otp -> reset\nUses environment variable `base_url`. Stores `vendor_otp` and `vendor_reset_token` when returned.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Vendor - Password Forgot (send OTP)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"501234567\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/vendor/otp/password/forgot",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api","v1","vendor","otp","password","forgot"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.data) {",
              "  if (json.data.otp_session_id) { pm.environment.set('vendor_otp_session_id', json.data.otp_session_id); }",
              "  if (json.data.otp) { pm.environment.set('vendor_otp', json.data.otp); }",
              "}",
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Vendor - Password Verify OTP (create reset token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"501234567\",\n  \"otp\": \"{{vendor_otp}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/vendor/otp/password/verify-otp",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api","v1","vendor","otp","password","verify-otp"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.data && json.data.reset_session_id) { pm.environment.set('vendor_reset_token', json.data.reset_session_id); }",
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Vendor - Password Reset",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"501234567\",\n  \"reset_token\": \"{{vendor_reset_token}}\",\n  \"password\": \"NewP@ssw0rd\",\n  \"password_confirmation\": \"NewP@ssw0rd\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/vendor/otp/password/reset",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api","v1","vendor","otp","password","reset"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
