        {
          "name": "Get Vendors With Stories (EN)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" },
              { "key": "Lang", "value": "en" }
            ],
            "url": { "raw": "{{base_url}}/api/user/stories/vendors", "host": ["{{base_url}}"], "path": ["api","user","stories","vendors"] }
          }
        },
