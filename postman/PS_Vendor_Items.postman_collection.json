{
  "info": {
    "name": "PS Vendor - Items Flow",
    "_postman_id": "d8f6c3d8-0000-4000-8000-000000000001",
    "description": "Full vendor add-item cycle: login -> lookups -> create -> list -> get -> update -> delete",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Vendor Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+966500000000\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/vendor/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api","v1","vendor","auth","login"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// save vendor token",
              "if (pm.response.code === 200) {",
              "  var json = pm.response.json();",
              "  if (json && json.data && json.data.token) {",
              "    pm.environment.set('vendor_token', json.data.token);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Item Lookups",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vendor_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/vendor/items/lookups",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api","v1","vendor","items","lookups"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vendor_token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "images[]", "type": "file", "src": "" },
            { "key": "category_id", "value": "1", "type": "text" },
            { "key": "piece_type_id", "value": "1", "type": "text" },
            { "key": "brand_id", "value": "1", "type": "text" },
            { "key": "gender_id", "value": "1", "type": "text" },
            { "key": "size_id", "value": "1", "type": "text" },
            { "key": "color_id", "value": "1", "type": "text" },
            { "key": "name", "value": "Sample Item", "type": "text" },
            { "key": "quantity_available", "value": "10", "type": "text" },
            { "key": "price", "value": "99.99", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/vendor/items",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api","v1","vendor","items"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// capture created item id",
              "if (pm.response.code === 200) {",
              "  var json = pm.response.json();",
              "  if (json && json.data && json.data.id) {",
              "    pm.environment.set('vendor_item_id', json.data.id);",
              "  }",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "List Items",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{vendor_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/vendor/items",
          "host": ["{{base_url}}"],
          "path": ["api","v1","vendor","items"]
        }
      },
      "response": []
    },
    {
      "name": "Get Item",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{vendor_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/vendor/items/{{vendor_item_id}}",
          "host": ["{{base_url}}"],
          "path": ["api","v1","vendor","items","{{vendor_item_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "Update Item",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{vendor_token}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "name", "value": "Sample Item Updated", "type": "text" },
            { "key": "price", "value": "79.99", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/vendor/items/{{vendor_item_id}}",
          "host": ["{{base_url}}"],
          "path": ["api","v1","vendor","items","{{vendor_item_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "Delete Item",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{vendor_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/vendor/items/{{vendor_item_id}}",
          "host": ["{{base_url}}"],
          "path": ["api","v1","vendor","items","{{vendor_item_id}}"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost" },
    { "key": "vendor_token", "value": "" },
    { "key": "vendor_item_id", "value": "" }
  ]
}
